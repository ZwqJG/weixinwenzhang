# 本地开发 Dockerfile：使用预构建的 .output（跳过 Docker 内构建避免 OOM）
FROM node:22-slim

ARG VERSION=unknown

LABEL maintainer="findsource@proton.me" \
      version="${VERSION}" \
      description="wechat-article-exporter Docker Image (local)" \
      org.opencontainers.image.source="https://github.com/wechat-article/wechat-article-exporter" \
      org.opencontainers.image.licenses="MIT"

# 安装 Chromium、中文字体和 CA 证书
RUN apt-get update && apt-get install -y \
    chromium fonts-noto-cjk fonts-noto-color-emoji ca-certificates \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

WORKDIR /app

# 从构建上下文（宿主机的 .output）复制
COPY .output ./
# puppeteer 被 Rollup external 排除，运行时需要从 node_modules 加载
RUN npm install --no-save --ignore-scripts puppeteer@24

# 创建 KV 存储目录并设置权限
RUN mkdir -p .data/kv && chown -R node:node /app

USER node

EXPOSE 3000

ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000

ENTRYPOINT ["node", "server/index.mjs"]
