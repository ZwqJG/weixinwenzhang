# 调试微信代理请求 (仅开发环境(development)支持)
NUXT_DEBUG_MP_REQUEST=false

# AG-Grid 企业版授权
NUXT_AGGRID_LICENSE=

# KV绑定 (EdgeOne: memory 模式, 重启后数据丢失)
# 如需持久化, 请改用外部 KV/数据库方案
NITRO_KV_DRIVER=memory

# EdgeOne 部署时无需设置 NITRO_KV_BASE
#
# ⚠️ 重要：NITRO_KV_BASE 配置项不可删除！
#     - 如使用 fs 驱动（NITRO_KV_DRIVER=fs），必须保留 NITRO_KV_BASE=.data/kv
#     - 缺少此行会导致用户数据（账号、文章缓存等）在重启后丢失
#     - 生产环境部署时务必检查该配置

DEBUG_KEY=
