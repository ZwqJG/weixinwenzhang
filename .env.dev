# ─── 本地开发环境配置 ───

# 调试微信代理请求 (仅开发环境支持)
NUXT_DEBUG_MP_REQUEST=true

# AG-Grid 企业版授权 (本地用社区版功能即可, 留空)
NUXT_AGGRID_LICENSE=

# KV 存储 — memory 模式, 重启后数据丢失, 本地开发不关心持久化
NITRO_KV_DRIVER=memory

# DEBUG 密钥 (调试 /api/_debug 用)
DEBUG_KEY=local-dev-key

# Sentry (本地不上报, 留空即可)
NUXT_SENTRY_DSN=
NUXT_SENTRY_ORG=
NUXT_SENTRY_PROJECT=
NUXT_SENTRY_AUTH_TOKEN=

# Umami 分析 (本地不上报)
NUXT_UMAMI_ID=
NUXT_UMAMI_HOST=
NUXT_UMAMI_DOMAINS=
